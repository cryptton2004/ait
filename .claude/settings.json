{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo clean)",
      "Bash(cargo run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(cargo add *)",
      "Bash(cargo remove *)",
      "Bash(cargo update *)",
      "Bash(cargo install *)",
      "Bash(git push *)",
      "Bash(git branch -D *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Edit(Cargo.toml)",
      "Edit(**/Cargo.toml)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(approvals.json)",
      "Write(approvals.json)",
      "Edit(.claude/**)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf ..*)",
      "Bash(rm -rf $*)",
      "Bash(rm -rf C:*)",
      "Bash(rm -rf /c/*)",
      "Bash(Remove-Item *)",
      "Bash(del *)",
      "Bash(rmdir *)",
      "Bash(format *)",
      "Bash(diskpart *)",
      "Bash(shutdown *)",
      "Bash(reg *)",
      "Bash(setx *)",
      "Edit(//c/**)",
      "Edit(~/**)",
      "Edit(../**)",
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/*.pem)"
    ]
  }
}
